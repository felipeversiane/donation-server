FROM postgres:16-bullseye

ENV BACKUP_DIR=/backups \
    BACKUP_SCHEDULE="0 0 * * *" \
    MAX_BACKUPS=7 \
    BACKUP_LOG_FILE=/backups/backup.log

RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends \
    build-essential \
    git \
    postgresql-server-dev-16 \
    cron \
    gnupg; \
  git clone --depth 1 --branch v0.6.0 https://github.com/pgvector/pgvector.git; \
  cd pgvector && make && make install; \
  cd / && rm -rf pgvector; \
  apt-get purge -y --auto-remove build-essential git postgresql-server-dev-16; \
  rm -rf /var/lib/apt/lists/*; \
  mkdir -p ${BACKUP_DIR}; \
  chown -R postgres:postgres ${BACKUP_DIR}

RUN echo 'CREATE EXTENSION IF NOT EXISTS vector;' > /docker-entrypoint-initdb.d/init.sql

COPY docker/backup.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/backup.sh

COPY docker/postgres-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/postgres-entrypoint.sh

USER root
ENTRYPOINT ["/usr/local/bin/postgres-entrypoint.sh"]
CMD ["postgres"]

